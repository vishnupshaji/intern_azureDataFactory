{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "dbtdeinternADF"
		},
		"dbtdeintenstorage1_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'dbtdeintenstorage1'"
		},
		"dbtdeinternstorage2_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'dbtdeinternstorage2'"
		},
		"simpel_proejct_databases_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'simpel_proejct_databases'"
		},
		"dbtdeinternstorage2_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://dbtdeinternstorage2.dfs.core.windows.net/"
		},
		"simpel_proejct_databases_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "dbtdeintern.database.windows.net"
		},
		"simpel_proejct_databases_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "dbtdeintern"
		},
		"simpel_proejct_databases_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "vishnu"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "dbtdeinternADF_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"dbtdeintenstorage1_connectionString": {
						"value": "[parameters('dbtdeintenstorage1_connectionString')]"
					},
					"dbtdeinternstorage2_accountKey": {
						"value": "[parameters('dbtdeinternstorage2_accountKey')]"
					},
					"simpel_proejct_databases_password": {
						"value": "[parameters('simpel_proejct_databases_password')]"
					},
					"dbtdeinternstorage2_properties_typeProperties_url": {
						"value": "[parameters('dbtdeinternstorage2_properties_typeProperties_url')]"
					},
					"simpel_proejct_databases_properties_typeProperties_server": {
						"value": "[parameters('simpel_proejct_databases_properties_typeProperties_server')]"
					},
					"simpel_proejct_databases_properties_typeProperties_database": {
						"value": "[parameters('simpel_proejct_databases_properties_typeProperties_database')]"
					},
					"simpel_proejct_databases_properties_typeProperties_userName": {
						"value": "[parameters('simpel_proejct_databases_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}